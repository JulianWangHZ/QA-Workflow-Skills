{
  "title": "plan.json — 自動化計畫：每個 @auto 情境的可行性、證據與前置資料（qa plan-merge 產生）",
  "type": "object",
  "required": [
    "version",
    "designHash",
    "entries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "designHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "feasibility",
          "probed",
          "evidence",
          "oracles"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^TC-\\d+$"
          },
          "feasibility": {
            "enum": [
              "AUTOMATABLE",
              "NEEDS_API_SETUP",
              "NOT_FEASIBLE"
            ]
          },
          "probed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "apiSetup": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "given",
                "how"
              ],
              "properties": {
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "how": {
                  "type": "string",
                  "minLength": 1
                },
                "available": {
                  "type": "boolean"
                }
              }
            }
          },
          "oracles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "then",
                "observable"
              ],
              "properties": {
                "then": {
                  "type": "string",
                  "minLength": 1
                },
                "observable": {
                  "type": "boolean"
                },
                "locator": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
