{
  "title": "review.json — 代碼審查：確定性檢查結果之上的獨立評分與結論",
  "type": "object",
  "required": [
    "version",
    "checksHash",
    "score",
    "breakdown",
    "verdict",
    "summary",
    "strengths",
    "findings",
    "suggestions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "checksHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "breakdown": {
      "type": "object",
      "required": [
        "fidelity",
        "reliability",
        "style",
        "productRisk",
        "maintainability"
      ],
      "properties": {
        "fidelity": {
          "type": "object",
          "required": [
            "score",
            "note"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reliability": {
          "type": "object",
          "required": [
            "score",
            "note"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "style": {
          "type": "object",
          "required": [
            "score",
            "note"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "productRisk": {
          "type": "object",
          "required": [
            "score",
            "note"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "maintainability": {
          "type": "object",
          "required": [
            "score",
            "note"
          ],
          "properties": {
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "APPROVE",
        "APPROVE_WITH_FIXES",
        "BLOCK"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "title",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d+$"
          },
          "severity": {
            "enum": [
              "critical",
              "important",
              "minor"
            ]
          },
          "category": {
            "enum": [
              "fidelity",
              "reliability",
              "style",
              "product-risk",
              "maintainability"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "detail": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "relatedCaseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
