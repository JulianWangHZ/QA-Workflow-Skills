{
  "title": "context.json — 上下文收集產物",
  "type": "object",
  "required": ["version", "scope", "changes", "existingTests", "integrations"],
  "properties": {
    "version": { "const": 1 },
    "scope": {
      "type": "object",
      "required": ["summary", "sources"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "inScope": { "type": "array", "items": { "type": "string" } },
        "outOfScope": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": {
              "type": { "enum": ["text", "issue", "pr", "diff", "doc", "design", "code"] },
              "ref": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["added", "modified", "deleted", "renamed"] },
          "note": { "type": "string" }
        }
      }
    },
    "existingTests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["unit", "api", "e2e"] },
          "covers": { "type": "string" }
        }
      }
    },
    "environment": { "type": "object" },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "available"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
