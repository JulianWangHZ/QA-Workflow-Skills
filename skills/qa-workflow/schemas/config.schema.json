{
  "title": ".qa/config.json — 專案設定",
  "type": "object",
  "required": [
    "version",
    "language",
    "layers",
    "repair",
    "report"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "language": {
      "enum": [
        "zh-TW",
        "en"
      ]
    },
    "layers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layer"
      }
    },
    "repair": {
      "type": "object",
      "required": [
        "maxLoops",
        "allowedPaths"
      ],
      "properties": {
        "maxLoops": {
          "type": "integer",
          "minimum": 0
        },
        "allowedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "properties": {
        "issueTracker": {
          "type": "string"
        },
        "design": {
          "type": "string"
        },
        "database": {
          "type": "string"
        }
      }
    },
    "report": {
      "type": "object",
      "required": [
        "dir"
      ],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseDesign": {
      "type": "object",
      "properties": {
        "minReviewScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxReviewRounds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bdd": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string"
        },
        "featuresDir": {
          "type": "string"
        },
        "stepsDir": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "timeoutSec": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "maxChunkLines": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "oracleAudit": {
          "type": "boolean"
        },
        "maxHealRounds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "language",
          "platforms",
          "style",
          "layers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "enum": [
              "typescript",
              "javascript",
              "python",
              "java",
              "other"
            ]
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "web",
                "app"
              ]
            }
          },
          "style": {
            "type": "string",
            "minLength": 1
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "bdd": {
            "type": "object",
            "properties": {
              "framework": {
                "type": "string"
              },
              "featuresDir": {
                "type": "string"
              },
              "stepsDir": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "junit": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "env": {
          "type": "object"
        },
        "timeoutSec": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
